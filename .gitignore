# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Training artifacts ---
*.pt
*.bin

# --- 3-root data layout: keep the dirs, ignore their contents ---
datasets/*
!datasets/.gitkeep
models/*
!models/.gitkeep
outputs/*
!outputs/.gitkeep

# Per-exemplar run output. NOT a bare `outputs/`: that would match the root one
# too, and git does not descend into an ignored directory, so `!outputs/.gitkeep`
# above could no longer re-include the scaffold.
exemplars/*/outputs/
projects/*/outputs/

# --- OS ---
.DS_Store
